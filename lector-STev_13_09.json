,"attention",null,null,null,null,"huanxin","Linear",0.5],["say","Trekker in the Line","We're in line for the Nova Geography Journal! The new issue just came out today.",0,""],["w",0.5],["ctl","avg3_139","a","006","idea",null,null,null,null,"jushou","Linear",0.5],["say","Interested Trekker","Oh, nice! So it's for a magazine.",0,""],["w",0.5],["mrt",1,"y","020","think",null],["say","avg3_100","They probably heard it was the final issue and rushed over...",2,""],["mrt",3,"y",null,null,null],["show","avg3_230","a","011",null,null,0.9,0,null,0.0],["w",0.5],["se","se_061"],["ctl","avg3_138","a",null,null,0.75,null,null,0.0,null,"OutSine",0.6],["ctl","avg3_139","a",null,null,0.25,null,null,0.0,null,"OutSine",0.6],["w",0.5],["se","se_112"],["ctl","avg3_230","a",null,null,null,-0.07,1.1,1.0,"2TiaoYue","OutQuad",1.0],["w",1.0],["ctl","avg3_230","a",null,"flurry",null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_230","Excuse me, coming through! Boss! Y-You made it.",0,""],["w",0.5],["mrt",1,"z","013","attention",null],["say","avg3_100","Morning, Mikan. Got another expedition for the New Star Guild?",1,""],["ctl","avg3_230","a","008",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["mrt",0,"z","002","idea",null],["say","avg3_100","Don't worry. The rate hasn't changed. Four Dorra is plenty.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_048"],["ctl","avg3_230","a","010",null,null,0.0,1.0,null,"jushou","OutQuad",0.5],["w",1],["bgm",""],["ctl","avg3_230","a","004",null,null,-0.22,1.25,null,null,"OutQuad",0.5],["w",0.5],["se","se_070"],["ctl","avg3_230","a","007",null,null,null,null,null,"buman","Linear",1.0],["say","avg3_230","No, no! We have money now!",0,""],["w",0.5],["stg",0,null,-30.0,1.2,"InOutBack",0.6,null,null,null],["se","se_061"],["trn",0,2,true,true,1.0],["w",1.0],["show","avg3_159","a","002",0.7,null,0.95,0,null,null],["show","avg3_232","a","002",0.43,null,0.95,0,null,null],["show","avg3_231","a","002",0.25,null,0.95,0,null,null],["cbg",0,null,-50.0,1.2,"Linear",0.0,null,null,null],["trn",1,2,false,false,1.0],["w",1.0],["bgm","m56"],["w",0.5],["mrt",1,"z","002","question",null],["say","avg3_100","Since when?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_159","a","007","music",null,null,null,null,"diantou","Linear",0.5],["say","avg3_159","Then it's settled. You can leave the survey fleet to the Trekker Association.",0,""],["w",0.5],["ctl","avg3_232","a","006","happy",null,null,null,null,"huanxin","Linear",0.5],["say","Omnisky Aegis Rep.","Gladly. We wouldn't have made it off that seamount alive without your team.",0,""],["w",0.5],["ctl","avg3_231","a","002","attention",null,null,null,null,null,"Linear",0.5],["say","United Harvest Manager","By the way, I'd like a few extra copies of the Journal. My department and the HQ execs want to see what we were up against out there.",0,""],["w",0.5],["ctl","avg3_159","a","002","music",null,null,null,null,"diantou","Linear",0.5],["say","avg3_159","Not a problem. Pleasure doing business with you.",0,""],["w",0.5],["stg",0,0.0,0.0,1.1,"OutQuad",0.8,null,null,null],["trn",0,0,true,true,1.0],["w",1.0],["bg","travellers_home_inside",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.5],["mrt",1,"z","017",null,null],["say","avg3_100","Looks like things are really turning around for the Trekker Association.",1,""],["mrt",3,"z",null,null,null],["show","avg3_159","a","002",null,null,null,0,null,0.0],["w",0.5],["ctl","avg3_159","a",null,null,null,-0.07,1.1,1.0,null,"OutQuad",0.6],["w",1],["ctl","avg3_159","a","007","music",null,null,null,null,null,"Linear",0.5],["say","avg3_159","Yeah. ♪ And we have your team to thank for it.",0,""],["w",0.5],["ctl","avg3_159","a","004","speechless",null,null,null,null,null,"Linear",0.5],["w",0.6],["trn",0,1,false,false,0.7],["w",0.7],["ctl","avg3_159","a",null,null,null,null,null,0.0,null,"Linear",0.3],["w",0.3],["film",0],["bg","view_sea_daylight",0,0.0],["trn",1,1,false,false,1.0],["w",0.4],["say","avg3_159","That seamount...==W== Or rather, that giant turtle has been heading toward the open ocean ever since that day.",0,""],["w",0.5],["ctl","avg3_159","a","002",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.3],["film",1],["bg","travellers_home_inside",0,0.7],["w",0.5],["ctl","avg3_159","a",null,null,null,null,null,1.0,null,"InQuad",0.5],["w",0.5],["ctl","avg3_159","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg3_159","Which means there's nowhere left to anchor out there.",0,""],["w",0.5],["ctl","avg3_159","a","009","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg3_159","The two companies read their own survey reports and faced the facts. With their current setups, long-term sea operations are impossible.",0,""],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","Hmm...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_159","a","002","attention",null,null,null,null,null,"Linear",0.5],["say","avg3_159","The reports also noted that our expedition outperformed them, both in wildlife research and ship modification.",0,""],["w",0.5],["ctl","avg3_159","a","003",null,null,null,null,null,null,"Linear",0.5],["say","avg3_159","So they made the smart choice. In short...",0,""],["w",0.5],["ctl","avg3_159","a","004",null,null,null,null,null,"diantou","Linear",0.5],["say","avg3_159","They're funding our open-sea fleet. When we set sail for the Monolith, they get to come along.",0,""],["w",0.5],["mrt",1,"z","014","attention",null],["say","avg3_100","Sounds like a pretty good deal for them.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_159","a","007","happy",null,null,null,null,null,"Linear",0.5],["say","avg3_159","Heh. The feeling is mutual.",0,""],["w",0.5],["ctl","avg3_159","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg3_159","The Association has spent years trying to fund a ship capable of open-sea voyages, all so we could resume the Snowcap Isle expedition.",0,""],["w",0.5],["se","se_062"],["ctl","avg3_159","a",n