ight Watcher squad operate?",0,""],["ctl","avg1_162","a","014",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["say","avg1_162","Um... No. I grew up in the Grand Arena, after all.",0,""],["ctl","avg1_162","a",null,null,null,null,null,null,null,"OutQuint",1.0],["ctl","avg3_182","b","024","sigh",null,null,null,null,"lengzhan","Linear",1.0],["stg",0,-100.0,null,1.25,"OutQuint",1.0,null,null,null],["say","avg3_182","Ha...==W== Now I know why you're flat broke,==W== and why your whole squad bailed on you.",0,""],["w",1.0],["se","se_101"],["ctl","avg3_182","b","024",null,0.62,-0.12,1.3,null,"JuGong","OutQuart",0.8],["goon"],["w",0.5],["goon"],["ctl","avg3_182","b",null,null,null,null,null,null,null,"OutQuint",0.7],["ctl","avg1_162","a","010","symbol",null,null,null,null,"lengzhan","OutQuint",0.7],["say","avg1_162","Wh-==W==why?",0,""],["w",0.3],["goon"],["ctl","avg3_182","b","027","awkward",null,null,null,null,"lengzhan","OutQuint",1.0],["ctl","avg1_162","a",null,null,null,null,null,null,null,"OutQuint",1.0],["stg",0,-200.0,-80.0,1.15,"OutQuint",1.0,null,null,null],["say","avg3_182","The two of you have zero street smarts...",0,""],["ctl","avg3_182","b","024",null,null,null,null,null,"niunie1","Linear",1.0],["se","se_208"],["say","avg3_182","Night Watchers make their living charging to put out fires and taking a share of recovered loot! In Emor, if business is slow, the Night Watchers will deliberately start fires!",0,""],["w",0.5],["stg",0,200.0,-50.0,1.25,"OutQuint",1.0,null,null,null],["ctl","avg3_182","b",null,null,null,null,null,null,null,"OutQuint",1.0],["ctl","avg1_162","a",null,"speechless",null,null,null,null,null,"OutQuint",1.0],["w",2.0],["ctl","avg1_162","a","019",null,null,null,null,null,"ChanDou1","Linear",1.0],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["se","se_070"],["say","avg1_162","Eh?",0,""],["bgm",""],["w",0.5],["trn",0,0,false,false,2.0],["w",2.0],["end"]]}