.5],["say","avg1_110","Don't tell me ...==W== you overslept?",0,""],["w",0.5],["ctl","avg3_136","a","010",null,null,null,null,null,"lengzhan","Linear",0.5],["ctl","avg3_137","a","010",null,null,null,null,null,"lengzhan","Linear",0.5],["ctl","avg1_110","c","003","question",null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["cbg",0,-60.0,null,null,"OutQuad",0.5,null,null,null],["stg",0,-150.0,null,1.3,"OutQuad",0.5,null,null,null],["ctl","avg3_137","a","013",null,null,null,null,null,"daintou","Linear",0.5],["say","avg3_137","I-It was my fault...",0,""],["w",0.5],["stg",0,150.0,null,null,"OutQuad",0.65,null,null,null],["cbg",0,60.0,null,null,"OutQuad",0.65,null,null,null],["ctl","avg1_110","c","013",null,null,null,null,null,null,"Linear",0.5],["ctl","avg3_136","a","012","exclamation",null,null,null,null,"lengzhan","Linear",0.5],["tsk","jushou"],["say","avg3_136","I was the one who slept in! I held Sapphire back!",0,""],["w",0.5],["stg",0,-150.0,null,null,"OutQuad",0.65,null,null,null],["cbg",0,-60.0,null,null,"OutQuad",0.65,null,null,null],["ctl","avg3_137","a","004",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_137","Ruby...",0,""],["w",0.5],["stg",0,150.0,null,null,"OutQuad",0.65,null,null,null],["cbg",0,60.0,null,null,"OutQuad",0.65,null,null,null],["ctl","avg3_136","a","010",null,null,null,null,null,null,"Linear",0.5],["say","avg3_136","I am so sorry, Lady Firenze! If I threw off the schedule, I'll take whatever punishment you've got!",0,""],["w",0.5],["stg",0,0.0,null,null,"OutQuad",0.5,null,null,null],["cbg",0,0.0,null,null,"OutQuad",0.5,null,null,null],["ctl","avg1_110","c","012","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_110","...",0,""],["ctl","avg1_110","c","003",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["ctl","avg1_110","c","008","music",null,null,null,null,"diantou","Linear",0.5],["ctl","avg3_136","a","004",null,null,null,null,null,null,"Linear",0.5],["ctl","avg3_137","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_110","Heh heh, relax. You're not actually late, so no harm done.",0,""],["w",0.5],["ctl","avg1_110","c","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_110","With the mountain of paperwork we've had lately, you must be exhausted. Thank you both for your hard work.",0,""],["w",0.5],["ctl","avg1_110","c","018",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_110","If you ever hit a wall or get overwhelmed, please tell me. We need everyone's voices heard if we want to make this company better.",0,""],["w",0.5],["stg",0,-150.0,null,null,"OutQuad",0.5,null,null,null],["cbg",0,-60.0,null,null,"OutQuad",0.5,null,null,null],["ctl","avg3_137","a","008",null,null,null,null,null,"jushou","Linear",0.5],["say","avg3_137","Thank you, Lady Firenze. But please don't push yourself too hard, either. You need to take care of yourself.",0,""],["w",0.5],["stg",0,150.0,null,null,"OutQuad",0.5,null,null,null],["cbg",0,0.0,null,null,"OutQuad",0.5,null,null,null],["ctl","avg1_110","c","008",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","I will. Don't worry about me. You two take plenty off my plate as it is.",0,""],["w",0.5],["ctl","avg1_110","c","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_110","Now then, I called you in today because I need a favor.",0,""],["w",0.5],["ctl","avg1_110","c","003","question",null,null,null,null,null,"Linear",0.5],["say","avg1_110","Are you familiar with the Philae Agricultural Fair?",0,""],["w",0.5],["stg",0,150.0,null,null,"OutQuad",0.5,null,null,null],["cbg",0,60.0,null,null,"OutQuad",0.5,null,null,null],["ctl","avg3_136","a","008","star",null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_136","Are you kidding? You took us there when we were kids! They had pumpkins taller than us, all those wacky planting gadgets, and tons of fun stalls!",0,""],["w",0.5],["se","se_412"],["stg",0,-150.0,null,null,"OutQuad",0.5,null,null,null],["cbg",0,-60.0,null,null,"OutQuad",0.5,null,null,null],["ctl","avg3_137","a","009",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg3_137","Of course. It's United Harvest's annual produce convention. Farmers from all over Philae come out to participate, right?",0,""],["w",0.5],["ctl","avg1_110","c","002",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","Spot on. But this year, the headquarters isn't getting involved. United Harvest Philae is running the show completely solo.",0,""],["w",0.5],["ctl","avg1_110","c","014","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_110","Which makes this fair a huge deal. Since it's our first time flying solo, I want to put the venue's security in the hands of people I actually trust.",0,""],["ctl","avg1_110","c","002",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["se","se_084"],["fx",0,"fx_avg_congr",0,0],["ctl","avg3_136","a","011",null,null,null,null,null,"daintou","Linear",0.5],["say","avg3_136","Leave it to us! We won't let you down!",0,""],["w",0.5],["stg",0,-120.0,-40.0,1.1,"OutQuad",0.5,null,null,null],["ctl","avg3_137","a","006",null,null,null,null,null,"jingxia","Linear",0.5],["say","avg3_137","... Hold on. If this were just standard crowd control, the Imperial Guard would be more than enough.",0,""],["w",0.5],["ctl","avg3_137","a","003",null,null,null,null,null,null,"Linear",0.5],["say","avg3_137","Which means ...==W== our job isn't just about guarding the venue, is it?",0,""],["w",0.5],["ctl","avg3_136","a","010",null,null,null,null,null,null,"Linear",0.5],["ctl","avg3_137","a","008",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["se","se_019"],["ctl","avg1_110","c","003",null,null,null,null,null,"youchupeng","Linear",0.5],["say","avg1_110","Sharp as ever, Sapphire. You just saved me a lot of breath.",0,""],["w",0.5],["bg","story_main_05_002",3,0.0],["show","avg3_215","a","002",0.52,null,null,3,null,null],["ctl","avg3_136","a",null,null,null,null,null,0.0,null,"Li