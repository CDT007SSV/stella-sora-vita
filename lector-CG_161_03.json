ll,null,null],["w",0.5],["cbg",0,null,null,null,"Linear",0.0,null,null,"stop"],["mrt",1,"y","010","sigh","chijing"],["say","avg3_100","Searched the whole island and couldn't find a trace of her. She's not picking up her phone either. Where is she?",2,""],["bgm","m46"],["mrt",0,"z","025","flurry",null],["say","avg3_100","Don't tell me... The \"ghost\" took her...?",1,""],["mrt",0,"z","009","sweaty","jushou2"],["say","avg3_100","N-No way! There's no such thing as a gho—",1,""],["mrt",3,"z",null,null,null],["w",0.5],["show","avg1_161","d","002",0.8,0.15,1.0,0,null,0.0],["se","se_372"],["ctl","avg1_161","d",null,null,0.1,null,null,0.8,null,"Linear",0.5],["w",1.5],["se","se_313"],["ctl","avg1_161","d",null,null,0.7,0.1,null,null,"LianTiao","OutSine",2.0],["w",2.0],["bgm",""],["mrt",2,"y","025","shock",null],["say","avg3_100","GHOST==W==?!!?!?!",2,""],["se","se_372"],["ctl","avg1_161","d",null,null,0.8,null,null,0.0,null,"Linear",0.5],["goon"],["bgm",""],["mrt",0,"y","010","sigh","chijing"],["say","avg3_100","That was close... I almost screamed. Was that really a ghost just now?",2,""],["mrt",0,"y","025","flurry",null],["say","avg3_100","Huh?! Isn't that thing heading toward our tent?!",2,""],["mrt",0,"z","026","exclamation",null],["say","avg3_100","No time to wait for the guards. I have to go for it...!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bgm",""],["se","se_148"],["bg","BG_Black",0,0.5],["w",0.5],["bg","forest_night_1",0,0.5],["se","se_099"],["stg",0,null,null,1.8,"OutCubic",0.5,null,null,null],["w",0.5],["trn",0,0,false,false,0.3],["w",0.3],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","BG_Black",0,0.0],["trn",1,0,false,false,0.3],["w",0.3],["se","se_063"],["fx",0,"fx_speedline_center_w",0,2],["mrt",2,"z","026",null,null],["say","avg3_100","Hey you! What are you doing in Leafia's tent—",1,""],["mrt",3,"z",null,null,null],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["bgm","m2"],["trn",1,0,false,false,3.0],["say","avg1_161","Boss.==W== Why are you==W== so out of breath?",11,""],["choice",["I was looking for you..."],[[]]],["choice",["Where were you, Leafia?"],[[]]],["say","avg1_161","I couldn't stop thinking about the west side. Since I couldn't sleep,==W== I headed out==W== on my own.",11,""],["choice",["So that's why you weren't in your tent..."],[[]]],["say","avg1_161","Sorry...==W== You were asleep, Boss,==W== and I didn't want to wake you...",11,""],["say","avg1_161","I …==W== made you worry, didn't I?",11,""],["choice",["I thought a ghost had snatched you away."],[[]]],["say","avg1_161","A ghost...?==W== Hehe,==W== you say funny things, Boss.",11,""],["say","avg1_161","I've got a half-finished map.==W== I don't have time to be snatched away by ghosts.",11,""],["say","avg1_161","Look!==W== I found all this==W== during tonight's survey!==W== Now I can finally finish mapping the west side!",11,""],["choice",["Your passion for maps is incredible, Leafia."],[[]]],["choice",["What drives you to push yourself this hard?"],[[]]],["say","avg1_161","Because I want to know.==W== I want to see what this land we live on==W== truly looks like,==W== and what it looked like==W== long ago...==W== I want to know it all.",11,""],["choice",["What it looked like long ago?"],[[]]],["say","avg1_161","Yeah. You saw it yourself, Boss.==W== What a thousand years can do to a place.",11,""],["say","avg1_161","It's a massive, yet almost invisible shift.==W== But if we take the time to look, we can uncover it.==W== Someone has to go out there==W== and find the truth, right?",11,""],["choice",["So that's why you studied archaeology?"],[[]]],["say","avg1_161","Yes. Understanding the unknown==W== brings me more joy than anything else.",11,""],["say","avg1_161","Snowcap Isle==W== fascinates me most of all.==W== It's completely uncharted.==W== I can't help but wonder==W== what's waiting out there.",11,""],["say","avg1_161","Hehe...==W== I'm already counting down the days==W== until I can map it all out.",11,""],["choice",["There's something wonderfully romantic about that."],[[]]],["say","avg1_161","Romantic...==W== No one's ever put it that way before.==W== Somehow,==W== hearing that makes me feel a little ticklish inside my heart.",11,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["bgm",""],["bg","forest_night_1",0,1.0],["w",1.0],["stg",0,null,null,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["bgm","m53"],["show","avg1_161","d","006",0.5,null,null,0,null,0.0],["ctl","avg1_161","d",null,null,null,null,null,1.0,"niunie1","Linear",0.5],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","You have to keep in touch and share your location. Everyone in the Trekker Association already lectured you on this, didn't they?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_112"],["ctl","avg1_161","d","010",null,null,null,null,null,"chijing","Linear",0.5],["w",1.0],["ctl","avg1_161","d","011","flurry",null,null,null,1.0,"niunie1","Linear",0.5],["say","avg1_161","Well, earlier it was the middle of the night. I fully intended to be back before you woke up...",0,""],["w",0.5],["mrt",1,"z","010","sigh",null],["say","avg3_100","You still could've left a note. I finally understand how your coworkers feel.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_161","d","008",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_161","Understood. If it means keeping your help, Boss... I'll try to...==W== Yawn...",0,""],["w",1.0],["se","se_146"],["ctl","avg1_161","d","011",null,null,null,null,null,"chijing","Linear",0.5],["se","se_096"],["ctl","avg1_161","d",null,null,null,null,null,0.0,null,"OutCubic",0.5],["hide","avg1_161",0.5],["w",0.5],["goon"],["w",0.5],["stg",0,null,50.0,1.2,"OutCubic",0.5,null,null,null],["mrt",2,"z","025","shock",null],["say","avg3_100","L-Leafia?!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bg","BG_Black",5,0.0],["show","avg1_161","d","003",null,null,null,5,null,1.0],["stage",5,0,0],["ctl","avg1_161","d","003","sleepy",null,null,n