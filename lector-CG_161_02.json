","Linear",0.5],["tsk","Xiao"],["goon"],["bgm",""],["w",0.5],["ctl","avg3_100","a",null,null,0.7,null,null,null,null,"InOutCubic",1.0],["trn",0,0,true,true,0.75],["w",0.75],["bg","uniseed_corridor",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["w",0.5],["trn",1,0,false,false,0.75],["w",1.25],["se","se_062"],["cbg",0,null,null,1.1,"OutQuad",0.5,null,null,null],["show","avg1_161","a","002",null,-0.1,null,0,null,0.0],["ctl","avg1_161","a",null,null,null,0.0,null,1.0,"chijing","OutQuad",0.5],["w",1.0],["bgm","m45"],["mrt",1,"z","021","awkward",null],["say","avg3_100","Why are we sneaking in?!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_161","a","007","star",null,-0.25,1.3,null,"diantou","OutQuad",0.5],["say","avg1_161","Because I'm not a United Harvest Philae employee, and this is a restricted area.",0,""],["w",0.5],["ctl","avg1_161","a","014",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_161","If they catch us, they'll kick us out.",0,""],["w",0.5],["mrt",1,"z","025","symbol","lengzhan"],["say","avg3_100","No, no, no! Isn't trespassing a crime...?!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_161","a","016",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg1_161","It's not trespassing. We're simply bypassing a few obstacles in our path. I even brought a grappling hook and a crowbar, just in case.",0,""],["w",0.5],["mrt",1,"z","019",null,null],["say","avg3_100","Those are straight-up burglar tools!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_030"],["ctl","avg1_161","a","003",null,null,null,null,null,null,"Linear",0.5],["say","avg1_161","No. They are essential surveying equipment.",0,""],["w",0.5],["mrt",1,"z","021","speechless",null],["say","avg3_100","... Are they?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_161","a","007","music",null,null,null,null,null,"Linear",0.5],["say","avg1_161","Yes. A grappling hook can measure distance, and it's also very convenient for scaling walls when you need to escape.",0,""],["w",0.5],["ctl","avg1_161","a","015",null,null,null,null,null,"youchupeng","Linear",0.5],["say","avg1_161","And the crowbar is for prying open locked—",0,""],["w",0.5],["se","se_070"],["stg",0,null,null,null,"Linear",0.5,null,null,"Xiao"],["cbg",0,null,null,null,"Linear",0.5,null,null,"Xiao"],["mrt",1,"z","007",null,null],["say","avg3_100","Stop, stop, stop!!!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_161","a","012","question",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_161","What's wrong?",0,""],["w",0.5],["mrt",1,"z","007",null,null],["say","avg3_100","I'll give you measuring distance, but escaping and picking locks have nothing to do with surveying!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_161","a","004",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_161","That's not true. If anything, it's humanity's fault for arbitrarily putting up walls and claiming parts of nature for themselves.",0,""],["w",0.5],["mrt",1,"z","020",null,null],["say","avg3_100","That is bizarrely persuasive...==W== Still, if we're going to all this trouble, why not just go through the proper channels?",1,""],["w",0.5],["mrt",0,"z","012","question","jushou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_161","a","005",null,null,null,null,null,null,"Linear",0.5],["say","avg1_161","Even if you follow the proper channels, some companies just refuse to cooperate.",0,""],["w",0.5],["ctl","avg1_161","a","007","star",null,null,null,null,"JuGong","Linear",0.5],["say","avg1_161","This method is the most efficient. It saves everyone's time.",0,""],["w",0.5],["mrt",1,"z","018",null,"diantou"],["say","avg3_100","I get it. I respect your passion and resolve, Leafia. But at the end of the day, this is still trespassing.",1,""],["w",0.5],["mrt",0,"z","002","attention",null],["say","avg3_100","Give me a second. I need to make a call.",1,""],["mrt",