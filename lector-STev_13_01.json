=W== Not another boat ride.",1,""],["w",0.5],["mrt",0,"z","021",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["se","se_099"],["ctl","avg1_161","a","006",null,null,-0.35,1.5,null,null,"Linear",0.3],["say","avg1_161","Afraid so. We're heading straight for that new underwater Monolith.",0,""],["w",0.5],["bgm",""],["trn",0,0,true,false,1.0],["w",1.0],["bg","BG_Black",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["se","se_055"],["say","avg1_161","The Trekkers' House in Port Bellin sent us a tip last week.",0,""],["w",0.5],["se","se_067"],["obj","qstory_event_13_009",0,null,null],["w",0.5],["bgm","m34"],["say","avg1_161","Fishermen spotted a massive seamount breaching the surface right after the Monolith appeared.",0,""],["say","avg1_161","We cross-referenced the charts, and there is absolutely no record of this seamount.",0,""],["w",0.5],["obj","qstory_event_13_009",1,null,null],["chd",0,0,"avg1_161","a","006","attention"],["say","avg1_161","We sailed through that exact spot two weeks ago. It was open water.",0,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["chd",1,0,"avg1_161","a","002",null],["objx"],["w",1.0],["bg","travellers_home_office",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["show","avg1_161","a","011",null,null,null,0,null,0.0],["ctl","avg1_161","a","011","speechless",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_161","Putting it all together, this seamount probably appeared overnight. But the weirdest part is...",0,""],["w",0.5],["ctl","avg1_161","a","002",null,0.35,null,null,null,null,"OutCubic",0.5],["show","avg1_111","a","002",0.7,null,null,0,null,0.0],["ctl","avg1_111","a","005","question",0.65,null,null,1.0,null,"OutCubic",0.5],["say","avg1_111","Seamounts don't usually break the surface. I read that in the Nova Geography Journal. That is really strange...",0,""],["w",0.5],["ctl","avg1_161","a","013","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_161","You read the Journal, Iris?"