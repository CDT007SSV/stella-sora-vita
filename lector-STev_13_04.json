j","qstory_main_07_007",0,null,null],["w",1.0],["say","avg3_100","I combed through the documents back then. One of the excavation clauses detailed a mandate for the Trekker Association.",0,""],["say","avg3_100","I just need you to verify if that rule is still active.",0,""],["w",0.5],["trn",0,0,false,false,1],["w",1],["stage",2,0,2],["objx"],["show","avg3_100","b","002",0.3,null,null,0,null,1.0],["show","avg3_152","a","019",0.5,null,null,2,null,null],["trn",1,0,false,false,1.0],["w",1.0],["ctl","avg3_152","a",null,"attention",null,null,null,null,"diantou2","Linear",0.5],["say","avg3_152","Makes sense. Once I find it, I'll double-check with management.",0,""],["w",0.5],["se","se_169"],["trn",0,1,true,false,1.0],["w",1.0],["bg","traveller_camp_a_daylight",1,0.5],["w",0.5],["stage",2,1,3],["bg","wog_office",0,0.0],["fx",0,"fx_avg_reminiscence_loop",1,2],["show","avg3_152","a","013",0.55,null,null,0,null,1.0],["trn",1,1,false,false,1.0],["w",1.0],["ctl","avg3_152","a","013","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_152","Monolith numbers in Nova are stabilizing, so it should be extremely rare for a new one to pop up.",0,""],["ctl","avg3_152","a","015",null,null,null,null,null,"chijing","Linear",0.5],["say","avg3_152","Honestly, I'm surprised a mandate this old is still on the books.",0,""],["ctl","avg3_152","a","015",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg3_152","Plus, companies and guilds handle things so well now, Grace Imperium just streamlined the preliminary surveys.==W== Nobody cares about the Trekker Association's surveys anymore.",0,""],["w",0.5],["ctl","avg3_152","a","018","sigh",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["show","avg1_161","a","014",0.4,null,null,1,null,0.0],["show","avg3_230","a","008",0.6,null,null,1,null,0.0],["ctl","avg1_161","a",null,null,null,null,null,1.0,null,"Linear",0.0],["ctl","avg3_230","a",null,null,null,null,null,1.0,null,"Linear",0.0],["ctl","avg3_152","a",null,null,0.8,